rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // كل مستخدم يقرأ ويكتب ملفه فقط
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // بيانات الصيدلية: فقط لمن رمز صيدليته يطابق
    match /pharmacies/{pid}/{document=**} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pharmacyId == pid;
    }
  }
}
